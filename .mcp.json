{
  "mcpServers": {
    "abap-adt": {
      "type": "http",
      "url": "http://localhost:2236/mcp",
      "headers": {
        "Authorization": "Bearer ${ABAP_ADT_TOKEN}"
      }
    },
    "fiori-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "--yes", "@sap-ux/fiori-mcp-server@1.15.19", "fiori-mcp"],
      "env": {}
    }
  }
}
