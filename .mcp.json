{
  "mcpServers": {
    "abap-adt": {
      "type": "http",
      "url": "http://localhost:2236/mcp",
      "headers": {
        "Authorization": "Bearer ${ABAP_ADT_TOKEN}"
      }
    },
    "arc-1-qas": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "scripts/mcp-launch.mjs",
        "arc-1-qas"
      ],
      "env": {}
    },
    "arc-1-prd": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "scripts/mcp-launch.mjs",
        "arc-1-prd"
      ],
      "env": {}
    },
    "arc-1-dev": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "scripts/mcp-launch.mjs",
        "arc-1-dev"
      ],
      "env": {}
    },
    "vsp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "scripts/mcp-launch.mjs",
        "vsp"
      ],
      "env": {}
    },
    "fiori-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "--yes",
        "@sap-ux/fiori-mcp-server@1.15.19",
        "fiori-mcp"
      ],
      "env": {}
    }
  }
}
