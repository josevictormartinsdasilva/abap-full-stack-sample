{
  "mcpServers": {
    "abap-adt": {
      "url": "http://localhost:2236/mcp",
      "bearerTokenEnvVar": "ABAP_ADT_TOKEN"
    },
    "arc-1": {
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "scripts/mcp-launch.mjs",
        "arc-1"
      ],
      "startupTimeoutMs": 300000
    },
    "vsp": {
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "scripts/mcp-launch.mjs",
        "vsp"
      ]
    },
    "fiori-mcp": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "--yes",
        "@sap-ux/fiori-mcp-server@1.15.19",
        "fiori-mcp"
      ],
      "startupTimeoutMs": 600000
    }
  }
}
