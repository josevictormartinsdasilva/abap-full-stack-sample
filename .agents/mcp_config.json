{
  "mcpServers": {
    "abap-adt": {
        "type": "streamableHttp",
        "url": "http://localhost:2236/mcp",
        "headers": {
           "Authorization": "Bearer <SEU_TOKEN>"
        },
        "disabled": false
    },
     "fiori-mcp": {
        "type": "stdio",
        "timeout": 600,
        "command": "npx",
        "args": ["--yes", "@sap-ux/fiori-mcp-server@1.15.19", "fiori-mcp"],
        "disabled": false
    }
  }
}