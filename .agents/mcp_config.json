{
  "mcpServers": {
    "abap-adt": {
      "type": "streamableHttp",
      "url": "http://localhost:2236/mcp",
      "headers": {
        "Authorization": "Bearer <SEU_TOKEN>"
      },
      "disabled": false
    },
    "arc-1": {
      "type": "stdio",
      "timeout": 300,
      "command": "node",
      "args": [
        "scripts/mcp-launch.mjs",
        "arc-1"
      ],
      "disabled": false
    },
    "vsp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/mcp-launch.mjs",
        "vsp"
      ],
      "disabled": false
    },
    "fiori-mcp": {
      "type": "stdio",
      "timeout": 600,
      "command": "npx",
      "args": [
        "--yes",
        "@sap-ux/fiori-mcp-server@1.15.19",
        "fiori-mcp"
      ],
      "disabled": false
    }
  }
}
