{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project": {
    "name": "abap-full-stack-antigravity",
    "description": "Convenções oficiais de nomenclatura baseadas no documento padrao-desenvolvimento.md para ABAP Cloud / RAP, ABAP Clássico / RICEFW e SAP Fiori",
    "referencia": "padrao-desenvolvimento.md",
    "idiomaPadrao": "Português (PT) - Códigos, objetos e descrições",
    "objetosLocais": "Prefixo Y (em vez de $TMP)"
  },
  "modulosSAP": {
    "AM": "Assets Management",
    "BC": "Basis Component",
    "CO": "Cost Accounting",
    "FI": "Financial Accounting",
    "FSCM": "Financial Supply Chain Management",
    "GL": "Cross Applications",
    "MM": "Materials Management",
    "PP": "Production Planning",
    "PS": "Project System",
    "SD": "Sales and Distribution",
    "WF": "Workflow",
    "WM": "Warehouse Management",
    "CCS": "Customer Care & Service",
    "CRM": "Customer Relationship Management",
    "CA": "Cross Application (Objetos reutilizáveis / independentes de módulo)",
    "FS": "Full Stack (Módulo do cenário de demonstração)"
  },
  "pacotes": {
    "superPacote": "Z<SIGLA>",
    "pacoteModulo": "Z<MD> (ex: ZFI, ZSD, ZMM, ZPP, ZCA, ZFS)",
    "pacoteProcesso": "Z<MD>_<PROCESSO> (nome do processo do Scope Item, ex: ZPP_PRODUCAO_ESTOQUE)",
    "pacoteDesenvolvimento": "Z<MD>_<PROCESSO_GAP> (nome do processo solicitado no GAP, ex: ZPP_AJUSTE_INVENTARIO)",
    "pacoteReutilizaveis": "ZCA / ZCA_UTILITARIO",
    "requestPacotes": "S4DK900336 - [Equipe ABAP]-[Objetos Iniciais]"
  },
  "requests": {
    "padrao": "<GAP>-<Descricao>",
    "exemplo": "FIAA-01-Inclusão de denominação no material",
    "projetoCTS": {
      "projeto": "S4D_P00001",
      "identificador": "ESTRUT_50",
      "descricao": "PROJETO ESTRUTURANTE 5.0"
    },
    "objetosIniciaisReutilizaveis": "S4DK900336"
  },
  "cdsAndRAP": {
    "viewBasic": {
      "padrao": "ZI_<MD>_<DESCRICAO>",
      "exemplo": "ZI_FS_TRAVEL, ZI_SD_CLIENTE",
      "descricao": "CDS View Entity básica (Basic / Core Data Source)"
    },
    "viewComposite": {
      "padrao": "ZI_<MD>_<DESCRICAO>",
      "exemplo": "ZI_FS_TRAVEL_CUBE",
      "descricao": "CDS View Entity de composição (Composite)"
    },
    "viewConsumption": {
      "padrao": "ZC_<MD>_<DESCRICAO>",
      "exemplo": "ZC_FS_TRAVEL, ZC_FS_BOOKING",
      "descricao": "CDS View Entity de consumo / projeção para UI"
    },
    "sqlViewName": {
      "padrao": "ZV<MD>_<DESCRICAO>",
      "exemplo": "ZVFS_TRAVEL",
      "descricao": "Nome da SQL View interna dentro da definição CDS (@AbapCatalog.sqlViewName)"
    },
    "accessControl": {
      "padrao": "Mesmo nome da View CDS (ZI_<MD>_<DESCRICAO> ou ZC_<MD>_<DESCRICAO>)",
      "exemplo": "ZI_FS_TRAVEL, ZC_FS_TRAVEL",
      "descricao": "Controle de Acesso DCL"
    },
    "valueHelp": {
      "padrao": "ZI_<MD>_VH_<DESCRICAO>",
      "exemplo": "ZI_FS_VH_AGENCIA, ZI_SD_VH_EXEMPLO",
      "descricao": "CDS View dedicada para Value Help / Help Search"
    },
    "metadataExtension": {
      "padrao": "Mesmo nome da CDS à qual o Metadata Extension se refere (ZC_<MD>_<DESCRICAO>)",
      "exemplo": "ZC_FS_TRAVEL, ZC_FS_BOOKING",
      "descricao": "Metadata Extension (DDLX) com anotações @UI"
    },
    "serviceDefinition": {
      "ui": {
        "padrao": "ZUI_<DESCRICAO>",
        "exemplo": "ZUI_TRAVEL, ZUI_FS_TRAVEL",
        "descricao": "Service Definition para consumo em UI5 / Fiori"
      },
      "api": {
        "padrao": "ZAPI_<MD>_<DESCRICAO>",
        "exemplo": "ZAPI_FS_TRAVEL, ZAPI_SD_ORDEM",
        "descricao": "Service Definition para consumo externo via Web API"
      }
    },
    "serviceBinding": {
      "uiODataV4": {
        "padrao": "ZUI_O4_<DESCRICAO>",
        "exemplo": "ZUI_O4_TRAVEL, ZUI_O4_FS_TRAVEL",
        "descricao": "Service Binding OData V4 para consumo Fiori UI5"
      },
      "uiODataV2": {
        "padrao": "ZUI_O2_<DESCRICAO>",
        "exemplo": "ZUI_O2_TRAVEL",
        "descricao": "Service Binding OData V2 para consumo Fiori UI5"
      },
      "apiODataV4": {
        "padrao": "ZAPI_O4_<DESCRICAO>",
        "exemplo": "ZAPI_O4_TRAVEL",
        "descricao": "Service Binding OData V4 para consumo via API"
      },
      "apiODataV2": {
        "padrao": "ZAPI_O2_<DESCRICAO>",
        "exemplo": "ZAPI_O2_TRAVEL",
        "descricao": "Service Binding OData V2 para consumo via API"
      }
    },
    "behaviorDefinition": {
      "base": "Mesmo nome da View Raiz: ZI_<MD>_<ENTIDADE>",
      "projection": "Mesmo nome da View de Projeção: ZC_<MD>_<ENTIDADE>"
    },
    "behaviorPoolClass": {
      "padrao": "ZCL<MD>_BP_<ENTIDADE> ou ZBP_C_<ENTIDADE>",
      "exemplo": "ZCLFS_BP_TRAVEL",
      "descricao": "Classe ABAP de implementação de comportamento do RAP"
    }
  },
  "dicionarioDeDados": {
    "tabelaTransparente": {
      "padrao": "ZT<MD>_<DESCRICAO>",
      "exemplo": "ZTFS_TRAVEL, ZTSD_PEDIDOS",
      "descricao": "Tabela de banco de dados transparente"
    },
    "tabelaDraft": {
      "padrao": "ZT<MD>_<DESCRICAO>_D",
      "exemplo": "ZTFS_TRAVEL_D, ZTFS_BOOKING_D",
      "descricao": "Tabela de draft para Business Object RAP"
    },
    "estrutura": {
      "padrao": "ZS<MD>_<DESCRICAO>",
      "exemplo": "ZSFS_TRAVEL_DATA, ZSCA_CAMPOS_CONTROLE",
      "descricao": "Estrutura do Dicionário ABAP"
    },
    "categoriaTabela": {
      "padrao": "ZCTG<MD>_<DESCRICAO> (ou ZTT<MD>_<DESCRICAO>)",
      "exemplo": "ZCTGFS_ITEMS, ZTTCA_LOG",
      "descricao": "Tipo de Tabela (Table Type)"
    },
    "visao": {
      "padrao": "ZV<MD>_<DESCRICAO>",
      "exemplo": "ZVSD_FATURAS",
      "descricao": "Visão de Dicionário"
    },
    "clusterVisao": {
      "padrao": "ZCV<MD>_<DESCRICAO>",
      "exemplo": "ZCVSD_CONFIG",
      "descricao": "Cluster de Visão"
    },
    "elementoDeDados": {
      "padrao": "ZE_<DESCRICAO>",
      "exemplo": "ZE_TRAVEL_REASON, ZE_DATA_CRIACAO",
      "descricao": "Elemento de Dados (prefixo ZE_)"
    },
    "dominio": {
      "padrao": "ZD_<DESCRICAO>",
      "exemplo": "ZD_STATUS_VIAGEM, ZD_TIPO_OPERACAO",
      "descricao": "Domínio (prefixo ZD_)"
    },
    "ajudaPesquisa": {
      "padrao": "ZH<MD>_<DESCRICAO>",
      "exemplo": "ZHSD_CLIENTES",
      "descricao": "Ajuda de Pesquisa (Matchcode / Search Help)"
    },
    "objetoBloqueio": {
      "padrao": "EZ<MD>_<DESCRICAO>",
      "exemplo": "EZFS_TRAVEL, EZSD_ORDEM",
      "descricao": "Objeto de Bloqueio (Lock Object / Enqueue)"
    },
    "bancoDadosLogico": {
      "padrao": "ZBD<MD>_<DESCRICAO>",
      "exemplo": "ZBDSD_VENDAS",
      "descricao": "Banco de dados lógico"
    }
  },
  "programacaoClassica": {
    "programa": {
      "padrao": "Z<MD><TIPO>_<DESCRICAO>",
      "tipos": {
        "C": "Carga",
        "I": "Interface",
        "F": "Formulário",
        "R": "Relatório",
        "W": "Workflow"
      },
      "exemplo": "ZMMR_ESTOQUE_ANALITICO, ZSDI_INTEGRACAO_ORDEM",
      "descricao": "Programa executável / Report clássico (PROG)"
    },
    "include": {
      "padrao": "Z<MD><TIPO>_<DESCRICAO>_<SUFIXO>",
      "tipos": "C, I, F, R, W ou E (Exit/Enhancement)",
      "sufixos": {
        "TOP": "Declarações globais e tipos",
        "SEL": "Telas de seleção (SELECT-OPTIONS, PARAMETERS)",
        "PBO": "Módulos Process Before Output",
        "PAI": "Módulos Process After Input",
        "F01": "Subrotinas e Forms",
        "F02": "Subrotinas adicionais",
        "Sem Tipo": "Includes genéricos"
      },
      "exemplo": "ZMMR_ESTOQUE_TOP, ZMMR_ESTOQUE_F01"
    },
    "moduloPool": {
      "padrao": "Z<MD><TIPO>_<DESCRICAO>",
      "exemplo": "ZMMF_TELA_APROVACAO",
      "descricao": "Programa de telas Dynpro"
    },
    "telasDynpro": {
      "faixaNumerica": "9000 a 9999",
      "layout": "Padrão oficial SAP (barra de ferramentas, botões, atalhos)"
    },
    "grupoFuncoes": {
      "padrao": "ZFG<MD>_<DESCRICAO>",
      "exemplo": "ZFGSD_CALCULOS, ZFGCA_UTILITARIOS",
      "descricao": "Grupo de Funções (FUGR/F)"
    },
    "moduloFuncao": {
      "padrao": "ZFM<MD>_<DESCRICAO>",
      "exemplo": "ZFMSD_CALCULA_DESCONTO, ZFMCA_GRAVA_LOG",
      "descricao": "Módulo de Função / RFC (FUGR/FF)"
    },
    "bapi": {
      "padrao": "ZBAPI<MD>_<DESCRICAO> ou Z_BAPI_<DESCRICAO>",
      "exemplo": "ZBAPISD_CRIA_ORDEM",
      "descricao": "BAPI Z customizada"
    },
    "classeGlobal": {
      "padrao": "ZCL<MD>_<DESCRICAO>",
      "exemplo": "ZCLSD_ORDEM_VENDA, ZCLCA_UTILITARIO",
      "descricao": "Classe Global OO (SE24 / CLAS)"
    },
    "interfaceGlobal": {
      "padrao": "ZIF<MD>_<DESCRICAO>",
      "exemplo": "ZIFSD_PROCESSOR",
      "descricao": "Interface Global OO (SE24 / INTF)"
    },
    "classeExcecao": {
      "padrao": "ZCX<MD>_<DESCRICAO>",
      "exemplo": "ZCXSD_ERRO_VALIDACAO",
      "descricao": "Classe de Exceção baseada em CX_ROOT"
    },
    "classeLocal": {
      "padrao": "LCL_<NOME>",
      "descricao": "Classe local em programas ou classes"
    },
    "interfaceLocal": {
      "padrao": "LIF_<NOME>",
      "descricao": "Interface local em programas ou classes"
    },
    "transacao": {
      "padrao": "Z<MD><PROCESSO>",
      "exemplo": "ZSD01, ZMM_INV",
      "descricao": "Transação clássica (SE93)"
    },
    "classeMensagem": {
      "padrao": "Z<MD>_<DESCRICAO>",
      "exemplo": "ZSD_MENSAGENS, ZFS_TRAVEL",
      "descricao": "Classe de Mensagem (SE91 / MSAG)"
    },
    "areaMenu": {
      "padrao": "Z<MD>_<DESCRICAO>",
      "exemplo": "ZSD_MENU_PRINCIPAL",
      "descricao": "Área de Menu (SE43)"
    }
  },
  "formularios": {
    "smartForms": {
      "padrao": "ZSF<MD>_<DESCRICAO>",
      "exemplo": "ZSFSD_DANFE"
    },
    "sapScript": {
      "padrao": "ZSS<MD>_<DESCRICAO>",
      "exemplo": "ZSSSD_ETIQUETA"
    },
    "adobeForms": {
      "padrao": "ZAF<MD>_<DESCRICAO>",
      "exemplo": "ZAFSD_BOLETO",
      "observacao": "Não utilizar Interactive Forms sem licença (apenas Adobe Forms Print)"
    },
    "smartStyles": {
      "padrao": "ZST<MD>_<DESCRICAO>",
      "exemplo": "ZSTSD_ESTILO_PADRAO"
    }
  },
  "extensibilidadesEIntegracoes": {
    "enhancementImplementation": {
      "padrao": "ZEI<MD>_<DESCRICAO>",
      "exemplo": "ZEISD_PRECO_CUSTOM"
    },
    "badi": {
      "padrao": "Z<MD>_<DESCRICAO>",
      "exemplo": "ZSD_CALCULO_IMPOSTO"
    },
    "cmodSmodExit": {
      "padrao": "Z<MD>_<DESCRICAO>",
      "exemplo": "ZSD_USEREXIT_SAVE"
    },
    "idoc": {
      "tipoIDoc": "Z<MD>TI_<DESCRICAO> (WE30)",
      "tipoMensagem": "Z<MD>TM_<DESCRICAO>",
      "segmentoIDoc": "Z<MD>SI_<DESCRICAO>"
    },
    "sproxy": {
      "regra": "Gerar a partir da Interface de Serviço usando o prefixo Z<MD>"
    },
    "snro": {
      "padrao": "Z<DESCRICAO>",
      "exemplo": "ZNR_VIAGEM, ZNR_PEDIDO"
    },
    "logSLG0": {
      "objeto": "Z<MD>_<DESCRICAO>",
      "subObjeto": "Descrição livre"
    },
    "autorizacaoSU21": {
      "padrao": "Z<DESCRICAO>",
      "campoObrigatorio": "ACTVT (01-Criar, 02-Modificar, 03-Exibir, 06-Eliminar)"
    }
  },
  "segwODataClassico": {
    "projeto": "Z<MD>_<DESCRICAO>",
    "mpcClass": "ZCL<MD>_<NOME>_MPC",
    "mpcExtClass": "ZCL<MD>_<NOME>_MPC_EXT",
    "dpcClass": "ZCL<MD>_<NOME>_DPC",
    "dpcExtClass": "ZCL<MD>_<NOME>_DPC_EXT",
    "technicalModel": "Z<MD>_<NOME>_MDL",
    "technicalService": "Z<MD>_<NOME>_SRV"
  },
  "hanaAMDP": {
    "tableFunction": {
      "padrao": "ZTB_<MD>_<DESCRICAO>",
      "exemplo": "ZTB_SD_FATURAMENTO"
    },
    "classeAMDP": {
      "padrao": "ZCL_<MD>_<DESCRICAO>",
      "exemplo": "ZCL_SD_AMDP_FATURAS"
    },
    "metodoAMDP": {
      "padrao": "AMDP_<ACAO>",
      "exemplo": "AMDP_CALCULA_FATURAMENTO"
    },
    "calculationViewExternal": {
      "padrao": "ZEXV<MD>_<DESCRICAO>",
      "exemplo": "ZEXVSD_VENDAS"
    }
  },
  "prefixosVariaveisCodigo": {
    "programaGlobal": {
      "types": "TY_*",
      "constants": "GC_*",
      "variaveis": "GV_*",
      "tabelaInterna": "GT_*",
      "estrutura": "GS_*",
      "fieldSymbols": "<GFS_*",
      "tableControl": "TC_*",
      "tabStrip": "TS_*",
      "parameters": "P_*",
      "selectOptions": "S_*"
    },
    "formSubrotina": {
      "form": "F_*",
      "parametroUsing": "UV_* / UT_* / US_* (Valor, Tabela, Estrutura)",
      "parametroChanging": "CV_* / CT_* / CS_*",
      "parametroTables": "LT_* (Preferir USING/CHANGING)"
    },
    "classesEInterfacesGlobais": {
      "types": "TY_*",
      "typeTable": "TT_*",
      "constants": "GC_*",
      "range": "GR_*",
      "variavel": "GV_*",
      "estrutura": "GS_*",
      "tabela": "GT_*",
      "objeto": "GO_*",
      "referencia": "GRR_*"
    },
    "parametrosMetodosEFuncoes": {
      "importing": "IV_* (Valor), IS_* (Estrutura), IT_* (Tabela), IO_* (Objeto), IR_* (Referência)",
      "exporting": "EV_* (Valor), ES_* (Estrutura), ET_* (Tabela), EO_* (Objeto), ER_* (Referência)",
      "changing": "CV_* (Valor), CS_* (Estrutura), CT_* (Tabela), CO_* (Objeto), CR_* (Referência)",
      "returning": "RV_* (Valor), RS_* (Estrutura), RT_* (Tabela), RO_* (Objeto), RR_* (Referência)",
      "regraTables": "Parâmetro TABLES em funções é obsoleto: NÃO UTILIZAR!"
    },
    "variaveisLocais": {
      "types": "TY_*",
      "typeTable": "TT_*",
      "constants": "LC_*",
      "range": "LR_*",
      "variavel": "LV_*",
      "tabelaInterna": "LT_*",
      "objeto": "LO_*",
      "estrutura": "LS_*",
      "fieldSymbols": "<FS_*",
      "referencia": "LRF_*"
    }
  },
  "qualidadeATC": {
    "obrigatoriedade": "Nenhum código será aceito com erros no resultado da validação do ATC",
    "verificacoesPrincipais": [
      "Performance: WHERE em SELECT/UPDATE/DELETE, evitar SELECT * em tabelas grandes, FOR ALL ENTRIES com tabela verificada",
      "Sintaxe estendida (SLIN) e sem operações de banco dentro de loops",
      "Validações CDS: Syntax Check de DDL, DCL e DDLX",
      "Verificação de tratamento de SY-SUBRC após operações críticas"
    ]
  },
  "fioriFrontend": {
    "moduleName": "<Nome do APP> (Máximo 21 caracteres)",
    "namespace": "br.com.<cliente>",
    "bspDeploy": "ZZ1_<NOME_ABREV> (Máximo 15 caracteres no total)",
    "routing": {
      "listReport": "<Entidade>List",
      "objectPage": "<Entidade>ObjectPage",
      "subObjectPage": "<EntidadePai>__<NavFilho>ObjectPage"
    }
  }
}
