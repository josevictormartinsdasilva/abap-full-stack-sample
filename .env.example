# Preencha com o assistente: node scripts/setup.mjs (detecta o sistema e grava este arquivo).
# Edição manual continua possível; confira depois com node scripts/doctor.mjs.

ABAP_ADT_TOKEN=<SEU_TOKEN>

# ---------------------------------------------------------------------------
# vsp e arc-1 (standards/politica-mcp-abap.md, ADR-0009)
# Um projeto por cliente, com uma conexão por sistema. Cada entrada de
# .agents/mcp.servers.json tem o seu prefixo de variáveis:
#   vsp        -> VSP_*        DEV do cliente
#   arc-1-qas  -> ARC1_QAS_*   QAS do cliente (somente leitura)
#   (PRD: sem entrada; nenhum servidor acessa o ambiente produtivo, ADR-0014)
#   arc-1-dev  -> ARC1_DEV_*   DEV do cliente via ARC-1 (opcional: exceção 4.2 ou 2º fallback em 2025+)
# Sistema que o cliente não tem (ou que você não vai usar): deixe com o placeholder.
# O servidor aparece como falho no /mcp, o que é esperado.
#
# Lidas por scripts/mcp-launch.mjs: primeiro do ambiente do sistema, depois deste .env.
# Informe só a conexão: SID, release e ambiente são detectados no próprio SAP.
# <P>_SAP_SID é opcional; se informado e diferente do detectado, o launcher recusa iniciar.
# Diagnóstico: node scripts/mcp-launch.mjs <servidor> --diagnostico
#
# Formato: NOME=valor, uma por linha; comentário só em linha própria, começando com #.
# NÃO há comentário no fim da linha: em "SENHA=abc # x", o valor é "abc # x" (senhas podem ter #).
# Valores com <...> são tratados como placeholder não preenchido. Na senha, só se o valor
# inteiro for <...> (ex.: <SENHA>); uma senha real com < e > no meio é aceita.
# ---------------------------------------------------------------------------

# DEV — vsp: desenvolvimento em S/4HANA <= 2023; em 2025+, só como fallback do abap-adt
VSP_SAP_URL=<https://host:porta>
# VSP_SAP_SID=<SID>    (opcional, conferência; use o mesmo de cliente.sistemaDesenvolvimento)
VSP_SAP_CLIENT=<MANDANTE>
VSP_SAP_USER=<USUARIO>
VSP_SAP_PASSWORD=<SENHA>
VSP_ALLOWED_PACKAGES=$TMP,Z*
# Edição de objetos transportáveis (ex.: DS4K*):
# VSP_ALLOWED_TRANSPORTS=<SID>K*
# VSP_ENABLE_TRANSPORTS=true   (criar/liberar requests; só sob pedido explícito)
# VSP_READ_ONLY=true           (DEV apenas para análise)
# VSP_FALLBACK_2025=true       (fallback do abap-adt num DEV/SANDBOX S/4HANA 2025+, política 4.4;
#                               ligue só quando o abap-adt não oferecer a operação)

# DEV — arc-1-dev (opcional): o mesmo DEV do vsp, pelo ARC-1. Sem as flags abaixo, só leitura. Usos:
#   - exceção controlada (política 4.2): escrita num DEV <= 2023, quando o cliente não autoriza o vsp;
#   - 2º fallback do abap-adt num DEV 2025+ (política 4.4), se o vsp não atender.
ARC1_DEV_SAP_URL=<https://host:porta>
# ARC1_DEV_SAP_SID=<SID>   (opcional, conferência; use o mesmo de cliente.sistemaDesenvolvimento)
ARC1_DEV_SAP_CLIENT=<MANDANTE>
ARC1_DEV_SAP_USER=<USUARIO>
ARC1_DEV_SAP_PASSWORD=<SENHA>
# ARC1_DEV_ALLOW_DEV_WRITES=true
# ARC1_DEV_ALLOWED_PACKAGES=Z*
# ARC1_DEV_FALLBACK_2025=true   (só em 2025+, junto com as duas acima; ligue só quando o vsp não atender)

# QAS — arc-1-qas: análise somente leitura (S/4HANA <= 2023; em 2025+, contingência e fallback de análise do abap-adt)
ARC1_QAS_SAP_URL=<https://host:porta>
# ARC1_QAS_SAP_SID=<SID>   (opcional, conferência)
ARC1_QAS_SAP_CLIENT=<MANDANTE>
ARC1_QAS_SAP_USER=<USUARIO_SOMENTE_LEITURA>
ARC1_QAS_SAP_PASSWORD=<SENHA>
# Opcional, experimental: ARC1_QAS_BLOCKED_DATA_SOURCES=USR02,PA0002

# Valem para todas as entradas (sem prefixo por sistema):
# Opcional: VSP_BIN=<caminho do binário vsp> (padrão: o launcher baixa a última release estável e confere o SHA-256)
# Opcional: VSP_VERSION=<x.y.z> (fixa uma versão do vsp em vez da última estável)
# Opcional: ARC1_BIN=<caminho do arc-1 instalado> (padrão: o launcher instala a última versão estável do npm)
# Opcional: ARC1_VERSION=<x.y.z> (fixa uma versão do ARC-1 em vez da última estável)
