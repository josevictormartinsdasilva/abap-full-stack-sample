ABAP_ADT_TOKEN=<SEU_TOKEN>

# ---------------------------------------------------------------------------
# arc-1 e vsp (standards/politica-mcp-abap.md, ADR-0009)
# Lidas por scripts/mcp-launch.mjs: primeiro do ambiente do sistema, depois deste .env.
# Informe só a conexão: SID, release e ambiente são detectados no próprio SAP.
# <P>_SAP_SID é opcional; se informado e diferente do detectado, o launcher recusa iniciar.
# Servidor com sufixo usa prefixo com sufixo (ex.: arc-1-qas-ne -> ARC1_QAS_NE_SAP_URL).
# Diagnóstico: node scripts/mcp-launch.mjs <servidor> --diagnostico
# ---------------------------------------------------------------------------

# ARC-1 — análise somente leitura em QAS/PRD (S/4HANA <= 2023)
ARC1_SAP_URL=<https://host:porta>
# ARC1_SAP_SID=<SID>   (opcional, conferência)
ARC1_SAP_CLIENT=<MANDANTE>
ARC1_SAP_USER=<USUARIO_SOMENTE_LEITURA>
ARC1_SAP_PASSWORD=<SENHA>
# Só usada se o sistema do ARC-1 for detectado como DEV/SANDBOX (exceção da política, seção 4.2):
# ARC1_ALLOWED_PACKAGES=Z*
# Opcional, experimental: ARC1_BLOCKED_DATA_SOURCES=USR02,PA0002
# Opcional: ARC1_BIN=<caminho do arc-1 instalado> (em vez de npx arc-1@versão fixada)

# vsp — desenvolvimento em DEV/SANDBOX (S/4HANA <= 2023)
VSP_SAP_URL=<https://host:porta>
# VSP_SAP_SID=<SID>    (opcional, conferência)
VSP_SAP_CLIENT=<MANDANTE>
VSP_SAP_USER=<USUARIO>
VSP_SAP_PASSWORD=<SENHA>
VSP_ALLOWED_PACKAGES=$TMP,Z*
# Edição de objetos transportáveis (ex.: DS4K*):
# VSP_ALLOWED_TRANSPORTS=<SID>K*
# VSP_ENABLE_TRANSPORTS=true   (criar/liberar requests; só sob pedido explícito)
# VSP_READ_ONLY=true           (DEV apenas para análise)
# Opcional: VSP_BIN=<caminho do binário vsp> (padrão: vsp no PATH)
